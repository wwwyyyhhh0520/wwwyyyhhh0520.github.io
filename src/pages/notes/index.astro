---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const notes = (await getCollection('notes'))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title="Notes | Wang" description="学习笔记、论文阅读、算法复盘和技术碎片。">
  <p class="eyebrow">NOTES</p>
  <h1>Learning in public.</h1>
  <p class="lead">这里放短笔记。目标不是每篇都写成完整教程，而是把学习过程留下来：今天弄懂了什么、哪里还没懂、解决了什么问题。</p>

  <section class="section-block">
    <div class="section-head"><p class="eyebrow">ALL NOTES</p><h2>学习记录</h2></div>
    <div class="post-list">
      {notes.map((note) => (
        <a class="post-row" href={`/notes/${note.id}`}>
          <div>
            <p class="muted post-meta">{note.data.date.toLocaleDateString('zh-CN')} · {note.data.category}</p>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
            <div>{note.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </div>
          <span class="post-arrow">→</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
