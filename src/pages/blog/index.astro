---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))];
---
<Layout title="Blog | Wang" description="Wang 的个人博客：编程、AI、Agent、CAD、算法与学习记录。">
  <p class="eyebrow">BLOG</p>
  <h1>写我正在学习和思考的东西。</h1>
  <p class="lead">这里不只记录一个项目。编程、AI、Agent、CAD、算法、系统设计、论文阅读和阶段总结，只要值得以后回来再看，我都会写下来。</p>

  <section class="section-block">
    <div class="section-head"><p class="eyebrow">TOPICS</p><h2>内容分类</h2></div>
    <div class="tags">{categories.map((category) => <span class="tag">{category}</span>)}</div>
  </section>

  <section class="section-block">
    <div class="section-head"><p class="eyebrow">ARTICLES</p><h2>全部文章</h2></div>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-row" href={`/blog/${post.id}`}>
          <div>
            <p class="muted post-meta">{post.data.date.toLocaleDateString('zh-CN')} · {post.data.category}</p>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div>{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
          </div>
          <span class="post-arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section-block">
    <div class="section-head"><p class="eyebrow">QUICK NOTES</p><h2>学习笔记</h2></div>
    <p>短一些、更新更频繁的学习记录放在 Notes。它们可以是不完整的理解、论文摘要、算法复盘或者当天解决的一个技术问题。</p>
    <a class="button" href="/notes">进入 Notes →</a>
  </section>
</Layout>
