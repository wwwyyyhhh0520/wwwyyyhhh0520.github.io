---
const { title = 'Wang | AI Agent × MCP × CAD', description = 'Building reliable AI agents for engineering software.' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #e8edf2; background: #0b0f14; }
      * { box-sizing: border-box; }
      body { margin: 0; line-height: 1.7; }
      a { color: #8bd5ca; text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { width: min(980px, calc(100% - 40px)); margin: auto; }
      header { border-bottom: 1px solid #222b35; }
      nav { min-height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
      nav .links { display: flex; gap: 22px; flex-wrap: wrap; }
      main { padding: 72px 0 96px; }
      h1 { font-size: clamp(2.5rem, 7vw, 5.4rem); line-height: 1.05; margin: 0 0 24px; letter-spacing: -0.04em; }
      h2 { margin-top: 56px; font-size: 1.7rem; }
      h3 { margin-bottom: 6px; }
      p { color: #b8c1cc; }
      .muted { color: #7f8b99; }
      .tag { display: inline-block; border: 1px solid #2b3947; border-radius: 999px; padding: 4px 10px; margin: 4px 6px 4px 0; font-size: .85rem; color: #aebbc8; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; }
      .card { border: 1px solid #222b35; border-radius: 16px; padding: 22px; background: #10161d; }
      .hero { max-width: 820px; }
      .hero p { font-size: 1.15rem; max-width: 700px; }
      .cta { display: flex; gap: 16px; margin-top: 28px; flex-wrap: wrap; }
      .button { padding: 10px 16px; border-radius: 10px; border: 1px solid #334353; }
      .button.primary { background: #d8f3ee; color: #0b0f14; border-color: #d8f3ee; }
      article { max-width: 760px; }
      article h1 { font-size: clamp(2.2rem, 5vw, 4rem); }
      code { background: #151d26; padding: .15em .35em; border-radius: 5px; }
      pre { background: #111820; padding: 18px; overflow-x: auto; border-radius: 12px; border: 1px solid #222b35; }
      pre code { padding: 0; }
      footer { border-top: 1px solid #222b35; padding: 30px 0 50px; color: #697583; }
    </style>
  </head>
  <body>
    <header><nav class="wrap"><a href="/"><strong>Wang / Lab Notes</strong></a><div class="links"><a href="/projects">Projects</a><a href="/blog">Blog</a><a href="/about">About</a><a href="https://github.com/wwwyyyhhh0520">GitHub</a></div></nav></header>
    <main class="wrap"><slot /></main>
    <footer><div class="wrap">Building reliable AI agents for engineering software.</div></footer>
  </body>
</html>
