---
const { title = 'Wang | Blog', description = 'Wang 的个人博客：编程、AI、Agent、CAD、算法、阅读与学习记录。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title}</title>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#e8edf2;background:#080c11}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;line-height:1.7;background:radial-gradient(circle at 50% -10%,#17212b 0,#080c11 38%)}a{color:#8bd5ca;text-decoration:none}a:hover{text-decoration:underline}.wrap{width:min(1080px,calc(100% - 40px));margin:auto}header{border-bottom:1px solid #202933;background:rgba(8,12,17,.78);backdrop-filter:blur(12px);position:sticky;top:0;z-index:10}nav{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px}nav .links{display:flex;gap:22px;flex-wrap:wrap}main{padding:86px 0 110px}h1{font-size:clamp(3rem,7vw,6rem);line-height:.98;margin:0 0 28px;letter-spacing:-.055em;max-width:1000px}h2{margin:0;font-size:clamp(1.8rem,3vw,2.6rem);letter-spacing:-.025em;line-height:1.2}h3{margin:4px 0 8px;font-size:1.15rem}p{color:#aeb8c4}.lead{font-size:1.18rem;max-width:780px}.muted{color:#7f8b99}.eyebrow,.kicker{color:#79c9bd;font-size:.78rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.kicker{color:#748291;margin:0 0 8px}.tag{display:inline-block;border:1px solid #2b3947;border-radius:999px;padding:4px 10px;margin:4px 6px 4px 0;font-size:.82rem;color:#aebbc8}.tags{margin-top:18px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}.card{border:1px solid #202a35;border-radius:18px;padding:24px;background:linear-gradient(145deg,rgba(17,24,32,.95),rgba(12,17,23,.95))}.card p:last-child{margin-bottom:0}.hero{padding:34px 0 56px}.section-block{margin-top:84px}.section-head{margin-bottom:24px;max-width:760px}.section-head .eyebrow{margin-bottom:8px}.cta{display:flex;gap:12px;margin-top:30px;flex-wrap:wrap}.button{display:inline-block;padding:10px 17px;border-radius:10px;border:1px solid #334353;color:#dce5ed}.button.primary{background:#d8f3ee;color:#08100f;border-color:#d8f3ee;font-weight:650}.project-card{border:1px solid #273441;border-radius:20px;padding:28px;background:#0e151c;display:grid;grid-template-columns:1.3fr .7fr;gap:34px;align-items:center}.architecture{display:flex;flex-direction:column;gap:6px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.86rem}.architecture span{border:1px solid #293745;background:#121b24;padding:7px 10px;border-radius:8px;text-align:center;color:#c2ccd5}.architecture b{text-align:center;color:#617182;font-weight:400}.post-list{display:flex;flex-direction:column;border-top:1px solid #202a35}.post-row{display:grid;grid-template-columns:1fr auto;gap:24px;padding:26px 4px;border-bottom:1px solid #202a35;color:inherit}.post-row:hover{text-decoration:none;background:rgba(255,255,255,.015)}.post-row h3{color:#e8edf2;font-size:1.3rem}.post-row p{margin:5px 0}.post-meta{font-size:.85rem}.post-arrow{align-self:center;color:#79c9bd;font-size:1.4rem}article{max-width:780px}article h1{font-size:clamp(2.4rem,5vw,4.3rem)}article h2{margin-top:48px;font-size:1.8rem}article h3{margin-top:34px}article p,article li{font-size:1.04rem}article li{color:#aeb8c4;margin:.35rem 0}.article-divider{border:0;border-top:1px solid #26313d;margin:32px 0 42px}code{background:#151d26;padding:.15em .35em;border-radius:5px}pre{background:#111820;padding:18px;overflow-x:auto;border-radius:12px;border:1px solid #222b35}pre code{padding:0}footer{border-top:1px solid #202933;padding:32px 0 52px;color:#697583}@media(max-width:720px){.project-card{grid-template-columns:1fr}nav{align-items:flex-start;padding:16px 0;flex-direction:column;gap:8px}nav .links{gap:15px}main{padding-top:56px}.post-row{grid-template-columns:1fr}.post-arrow{display:none}}
</style></head><body><header><nav class="wrap"><a href="/"><strong>Wang / Notes</strong></a><div class="links"><a href="/blog">Blog</a><a href="/notes">Notes</a><a href="/projects">Projects</a><a href="/about">About</a><a href="https://github.com/wwwyyyhhh0520">GitHub</a></div></nav></header><main class="wrap"><slot /></main><footer><div class="wrap">Wang · 编程、AI、工程与持续学习。</div></footer></body></html>
